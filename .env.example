# ============ Cudjoe Digital Studio — environment variables ============
# Copy to .env.local for local dev. On Vercel, set these in Project Settings → Environment Variables.

# Public site URL (used for absolute download links in emails + sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign session cookies, cart cookies and download tokens.
# Generate one:  openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# ---------- Payments ----------
# Leave PAYSTACK_SECRET_KEY empty to run the DEMO gateway (simulated MoMo /
# Telecel prompt — great for local testing). Set it to go live with real
# MTN MoMo + Telecel Cash via Paystack (Ghana).
PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=pk_live_xxx
# PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Fallback gateway (optional): Flutterwave
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
# PAYMENT_GATEWAY=paystack

# ---------- Email (Resend) ----------
# Leave empty to log emails to the console instead of sending.
RESEND_API_KEY=
FROM_EMAIL=Cudjoe Digital Studio <onboarding@resend.dev>

# ---------- Downloads ----------
# Signed download link lifetime in seconds (default 172800 = 48 hours; max 604800)
DOWNLOAD_LINK_TTL_SECONDS=172800

# ---------- Supabase (production scale, optional) ----------
# The store ships with a file-backed demo database (works everywhere).
# Swap lib/store.ts + lib/catalog.ts for the Supabase adapter to scale:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=
